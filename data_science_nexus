# SECTION 10 · SYNTHESIS (MMR + TF-IDF + TextRank)
# ═══════════════════════════════════════════════════════════════════════════

class Synthesizer:
def __init__(self, lambda_mmr=0.75, max_sentences=12):
self.lambda_mmr = lambda_mmr
self.max_sentences = max_sentences

def synthesize(self, query, sources):
query_words = set(tokenize(query))
if not query_words:
return {"answer": "", "citations": [], "nb_sentences": 0, "nb_sources_used": 0}

all_sentences = []
df_counter = Counter()
for idx, s in enumerate(sources):
text = (s.get("title", "") + ". " + s.get("snippet", "")).strip()
for sent in split_sentences(text):
all_sentences.append({
"text": sent, "source_idx": idx,
"source": s.get("source", "?"),
"url": s.get("url", ""),
"title": s.get("title", ""),
})
for w in set(tokenize(sent)):
df_counter[w] += 1

if not all_sentences:
return {"answer": "", "citations": [], "nb_sentences": 0, "nb_sources_used": 0}

n_docs = len(sources)
for sent in all_sentences:
sent["score"] = self._tfidf(sent["text"], query_words, df_counter, n_docs)

filtered = [s for s in all_sentences
if any(w in tokenize(s["text"]) for w in query_words)]
if not filtered:
filtered = all_sentences

for src_idx in range(len(sources)):
sents_src = [s for s in filtered if s["source_idx"] == src_idx]
if len(sents_src) > 1:
tr = self._textrank([s["text"] for s in sents_src])
for i, s in enumerate(sents_src):
s["score"] = 0.7 * s["score"] + 0.3 * tr[i]

for s in filtered:
s["tokens"] = set(tokenize(s["text"]))
selected = self._mmr_select(filtered, self.max_sentences)

for s in selected:
s["type"] = self._classify(s["text"])
ordered = self._order(selected)
return self._build_answer(ordered)

@staticmethod
def _tfidf(sentence, query_words, df, n_docs):
words = tokenize(sentence)
if not words:
return 0.0
score = 0.0
for w in query_words:
freq = words.count(w)
if freq > 0:
df_w = df.get(w, 1)
idf = math.log((n_docs + 1) / (df_w + 1)) + 1
score += (1 + math.log(freq)) * idf
norm = math.log(len(words) + 1)
bonus = 1.2 if words[0] in query_words else 1.0
return (score / max(1, norm)) * bonus

@staticmethod
def _textrank(sentences, iterations=10, damping=0.85):
n = len(sentences)
if n <= 1:
return [1.0] * n
tokens = [set(tokenize(s)) for s in sentences]
scores = [1.0] * n
for _ in range(iterations):
new_scores = [1 - damping] * n
for i in range(n):
if not tokens[i]:
continue
for j in range(n):
if i == j or not tokens[j]:
continue
inter = len(tokens[i] & tokens[j])
union = len(tokens[i] | tokens[j])
if union == 0:
continue
sim = inter / union
out_deg = sum(
1 for k in range(n)
if k != j and tokens[j] and tokens[k] and
(len(tokens[j] & tokens[k]) / max(1, len(tokens[j] | tokens[k]))) > 0
)
if out_deg > 0:
new_scores[i] += damping * (sim / out_deg) * scores[j]
scores = new_scores
m = max(scores) or 1
return [s / m for s in scores]

def _mmr_select(self, candidates, k):
if not candidates:
return []
selected = []
remaining = list(candidates)
remaining.sort(key=lambda x: -x["score"])
selected.append(remaining.pop(0))
while len(selected) < k and remaining:
best_mmr = -1e9
best_idx = -1
for i, c in enumerate(remaining):
max_sim = max(
self._cosine(c["tokens"], s["tokens"]) for s in selected
) if selected else 0
mmr = self.lambda_mmr * c["score"] - (1 - self.lambda_mmr) * max_sim
if mmr > best_mmr:
best_mmr = mmr
best_idx = i
if best_idx >= 0:
selected.append(remaining.pop(best_idx))
else:
break
return selected

@staticmethod
def _cosine(a, b):
if not a or not b:
return 0.0
inter = len(a & b)
if inter == 0:
return 0.0
return inter / math.sqrt(len(a) * len(b))

@staticmethod
def _classify(sentence):
low = sentence.lower()
if any(w in low for w in ["est un", "est une", "se definit", "signifie",
"correspond", "is a", "is an", "refers to"]):
return "definition"
if any(w in low for w in ["selon", "d'apres", "etude", "recherche",
"en 20", "en 19", "according to", "study"]):
return "proof"
if any(w in low for w in ["donc", "ainsi", "par consequent",
"conclusion", "therefore", "thus"]):
return "consequence"
return "fact"

@staticmethod
def _order(sentences):
defs = [s for s in sentences if s["type"] == "definition"]
facts = [s for s in sentences if s["type"] == "fact"]
proofs = [s for s in sentences if s["type"] == "proof"]
conseq = [s for s in sentences if s["type"] == "consequence"]
return defs + facts + proofs + conseq

@staticmethod
def _build_answer(ordered):
parts = []
citations = []
seen_urls = set()
for i, s in enumerate(ordered, 1):
txt = s["text"].strip()
if not txt.endswith((".", "!", "?")):
txt += "."
ref_id = None
if s["url"]:
if s["url"] not in seen_urls:
ref_id = len(citations) + 1
seen_urls.add(s["url"])
citations.append({
"id": ref_id, "url": s["url"],
"title": (s["title"] or s["url"])[:120],
"source": s["source"],
})
else:
for c in citations:
if c["url"] == s["url"]:
ref_id = c["id"]
break
marker = " [{}]".format(ref_id) if ref_id else ""
parts.append("{}. {}{}".format(i, txt, marker))
return {
"answer": "\n\n".join(parts),
"citations": citations,
"nb_sentences": len(ordered),
"nb_sources_used": len(seen_urls),
}


