def run_benchmark():
queries = [
("dark matter detection", "physics"),
("transformer neural networks", "academic"),
("hippocampus memory", "neuro"),
("python async programming", "general"),
("CRISPR gene editing", "all"),
]
results = []
for q, domain in queries:
nexus = NexusScientific(lang="fr", domain=domain)
t0 = time.time()
r = nexus.answer(q)
ms = round((time.time() - t0) * 1000, 2)
results.append({
"query": q, "domain": domain, "ms": ms,
"sources": r.get("nb_sources_total", 0),
"cited": r.get("nb_sources_used", 0),
})
times = [r["ms"] for r in results]
return {
"queries": len(queries),
"avg_ms": round(sum(times) / len(times), 2) if times else 0,
"min_ms": round(min(times), 2) if times else 0,
"max_ms": round(max(times), 2) if times else 0,
"details": results,
}


