}
let html = '<div class="answer"><h2>Synthèse · ' + d.nb_sources_used +
' sources citées</h2><div class="body">' +
escapeHtml(d.answer).replace(/\[(\d+)\]/g, '<sup>[$1]</sup>') + '</div>';
if (d.citations && d.citations.length) {
html += '<div class="citations">';
d.citations.forEach(c => {
html += '<a class="citation" href="' + escapeAttr(c.url) +
'" target="_blank" rel="noopener"><b>[' + c.id + ']</b>' +
escapeHtml(c.title) + '<span class="src">' + escapeHtml(c.source) + '</span></a>';
});
html += '</div>';
}
html += '</div>';
document.getElementById('answer-container').innerHTML = html;
}

