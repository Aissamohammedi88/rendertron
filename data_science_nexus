def tokenize(text, remove_stopwords=True):
if not text:
return []
words = _word_rx.findall(text.lower())
if remove_stopwords:
return [w.strip("'-") for w in words if w not in STOPWORDS]
return [w.strip("'-") for w in words]


def split_sentences(text, min_len=30):
if not text:
return []
text = _ws_rx.sub(" ", text)
sents = _sentence_rx.findall(text)
return [s.strip() for s in sents if len(s.strip()) >= min_len]


def clean_html(text):
if not text:
return ""
text = _tag_rx.sub(" ", text)
text = html.unescape(text)
return _ws_rx.sub(" ", text).strip()


def fmt_bytes(n):
for u in ("B", "KB", "MB", "GB"):
if n < 1024:
return "{:.1f} {}".format(n, u)
n /= 1024
return "{:.1f} TB".format(n)


