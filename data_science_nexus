def fetch_all(query, sources=None, max_workers=16, lang="fr", timeout=30):
if sources is None:
sources = ALL_SOURCES
results = []
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = {}
for fn in sources:
try:
fut = ex.submit(fn, query, lang)
futures[fut] = fn.__name__
except Exception:
continue
try:
for fut in as_completed(futures, timeout=timeout):
try:
res = fut.result(timeout=10)
if res:
results.extend(res)
except Exception:
continue
except FutureTimeout:
pass
return results


