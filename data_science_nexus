def build_parser():
parser = argparse.ArgumentParser(
prog="nexus-scientific",
description="NEXUS Scientific v" + __version__ +
" — Le moteur de recherche scientifique le plus puissant.",
)
parser.add_argument("--version", action="version",
version="nexus-scientific " + __version__)
sub = parser.add_subparsers(dest="command")

p_a = sub.add_parser("answer", help="Answer a scientific question")
p_a.add_argument("query")
p_a.add_argument("--lang", default="fr")
p_a.add_argument("--domain", default="all",
choices=["all", "physics", "academic", "neuro", "general"])
p_a.add_argument("--json", action="store_true")
p_a.set_defaults(func=cmd_answer)

p_v = sub.add_parser("serve", help="Run HTTP server + dashboard")
p_v.add_argument("--host", default="127.0.0.1")
p_v.add_argument("--port", type=int, default=8095)
p_v.add_argument("--lang", default="fr")
p_v.set_defaults(func=cmd_serve)

p_t = sub.add_parser("test", help="Run internal tests")
p_t.set_defaults(func=cmd_test)

return parser


def main(argv=None):
parser = build_parser()
args = parser.parse_args(argv)
if not getattr(args, "command", None):
return cmd_serve(argparse.Namespace(host="127.0.0.1", port=8095, lang="fr"))
return args.func(args) or 0


if __name__ == "__main__":
sys.exit(main())
