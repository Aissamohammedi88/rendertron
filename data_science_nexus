def http_get(url, timeout=10, headers=None, retries=2, source="?"):
if CB.is_open(source):
METRICS.record_source_fail(source, "circuit open", "fail")
return {"ok": False, "err": "circuit_open"}

h = {"User-Agent": USER_AGENT, "Accept": "*/*", "Accept-Encoding": "gzip"}
if headers:
h.update(headers)

last_err = "?"
for attempt in range(retries + 1):
try:
req = urllib.request.Request(url, headers=h)
t0 = time.time()
with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as r:
raw = r.read(3_000_000)
if r.headers.get("Content-Encoding", "").lower() == "gzip":
try:
raw = gzip.decompress(raw)
except Exception:
pass
ms = round((time.time() - t0) * 1000, 1)
METRICS.record_latency(ms, source)
METRICS.record_source_ok(source)
CB.record_success(source)
return {"ok": True, "body": raw.decode("utf-8", "ignore"), "ms": ms}
except urllib.error.HTTPError as e:
last_err = "HTTP {}".format(e.code)
if e.code in (429, 503, 502, 504) and attempt < retries:
time.sleep((2 ** attempt) + random.uniform(0, 0.5))
continue
break
except socket.timeout:
last_err = "timeout"
if attempt < retries:
time.sleep((2 ** attempt) + random.uniform(0, 0.5))
continue
break
except Exception as e:
last_err = str(e)[:120]
if attempt < retries:
time.sleep((2 ** attempt) + random.uniform(0, 0.5))
continue
break

if last_err == "timeout":
METRICS.record_source_fail(source, last_err, "timeout")
else:
METRICS.record_source_fail(source, last_err, "fail")
CB.record_failure(source)
return {"ok": False, "err": last_err}


def http_post_json(url, payload, timeout=10, headers=None, source="?"):
if CB.is_open(source):
METRICS.record_source_fail(source, "circuit open", "fail")
return {"ok": False, "err": "circuit_open"}

h = {"User-Agent": USER_AGENT, "Content-Type": "application/json", "Accept": "*/*"}
if headers:
h.update(headers)

try:
req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h, method="POST")
t0 = time.time()
with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as r:
ms = round((time.time() - t0) * 1000, 1)
METRICS.record_latency(ms, source)
METRICS.record_source_ok(source)
CB.record_success(source)
return {"ok": True, "body": r.read().decode("utf-8", "ignore"), "ms": ms}
except Exception as e:
METRICS.record_source_fail(source, str(e)[:120], "fail")
CB.record_failure(source)
return {"ok": False, "err": str(e)[:120]}


