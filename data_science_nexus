class Metrics:
def __init__(self, window=1000):
self._lock = RLock()
self._window = window
self.latencies = deque(maxlen=window)
self.counters = defaultdict(int)
self.gauges = {}
self.source_stats = defaultdict(lambda: {
"ok": 0, "fail": 0, "timeout": 0,
"latencies": deque(maxlen=100),
"last_error": None, "last_ok": None,
})
self.started = time.time()

def record_latency(self, ms, source=None):
with self._lock:
self.latencies.append(ms)
if source:
self.source_stats[source]["latencies"].append(ms)

def inc(self, counter, n=1):
with self._lock:
self.counters[counter] += n

def set_gauge(self, name, value):
with self._lock:
self.gauges[name] = value

def record_source_ok(self, source):
with self._lock:
self.source_stats[source]["ok"] += 1
self.source_stats[source]["last_ok"] = time.time()

def record_source_fail(self, source, err, kind="fail"):
with self._lock:
self.source_stats[source][kind] += 1
self.source_stats[source]["last_error"] = (err, time.time())

def percentile(self, p):
with self._lock:
if not self.latencies:
return 0
data = sorted(self.latencies)
k = int(len(data) * p / 100)
k = min(k, len(data) - 1)
return round(data[k], 2)

def summary(self):
with self._lock:
ok = sum(self.source_stats[s]["ok"] for s in self.source_stats)
fail = sum(self.source_stats[s]["fail"] for s in self.source_stats)
timeout = sum(self.source_stats[s]["timeout"] for s in self.source_stats)
latency_data = list(self.latencies)
avg = round(sum(latency_data) / len(latency_data), 2) if latency_data else 0

per_source = {}
for s, d in self.source_stats.items():
lats = list(d["latencies"])
per_source[s] = {
"ok": d["ok"], "fail": d["fail"], "timeout": d["timeout"],
"avg_ms": round(sum(lats) / len(lats), 1) if lats else 0,
"last_ok": d["last_ok"], "last_error": d["last_error"],
"success_rate": round(
100 * d["ok"] / max(1, d["ok"] + d["fail"] + d["timeout"]), 1),
}

return {
"uptime_s": round(time.time() - self.started, 1),
"total_requests": self.counters.get("requests", 0),
"total_errors": self.counters.get("errors", 0),
"total_cache_hits": self.counters.get("cache_hits", 0),
"total_cache_misses": self.counters.get("cache_misses", 0),
"sources": {
"total_calls": ok + fail + timeout,
"ok": ok, "fail": fail, "timeout": timeout,
"per_source": per_source,
},
"latency_ms": {
"count": len(latency_data), "avg": avg,
"min": round(min(latency_data), 2) if latency_data else 0,
"max": round(max(latency_data), 2) if latency_data else 0,
"p50": self.percentile(50),
"p90": self.percentile(90),
"p95": self.percentile(95),
"p99": self.percentile(99),
},
"gauges": dict(self.gauges),
}


